# Production environment — copy to .env.prod and fill in. NEVER commit the real .env.prod.
#   cp .env.prod.example .env.prod  &&  edit values
# Used only by docker-compose.prod.yml (the dev compose ignores this).

# Public hostname (no scheme, no trailing slash). Drives ALLOWED_HOSTS, CSRF, nginx, certs.
DOMAIN=example.com

# Email for Let's Encrypt registration / expiry notices.
EMAIL=admin@example.com

# Django secret — generate a strong random value, keep it private.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Postgres credentials for the prod database.
POSTGRES_DB=maxdone
POSTGRES_USER=maxdone
POSTGRES_PASSWORD=change-me-strong-db-password

# Optional hardening (enable AFTER HTTPS is confirmed working):
#   DJANGO_SSL_REDIRECT=1          # let Django also force HTTPS (nginx already redirects)
#   DJANGO_HSTS_SECONDS=31536000   # 1 year HSTS — only once you're sure HTTPS is permanent
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
